# Environment Variables for Digital Art Marketplace

# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
# For local development with Docker:
# DATABASE_URL=postgresql://user:password@localhost:5432/artmarket
# For Heroku/Railway/Render:
# DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_URL=

# Authentication
JWT_SECRET=your-secure-jwt-secret-here-change-in-production

# Payment Provider (Stripe - test mode)
# Get your keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_test_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# File Storage (for future use)
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Email (for order confirmation - future use)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# FROM_EMAIL=
